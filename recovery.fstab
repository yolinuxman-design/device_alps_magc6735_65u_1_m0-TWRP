# Mount points use MTK by-name symlinks (confirmed by ro.frp.pst in stock build.prop)

/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system    /system      ext4   ro,barrier=1,discard                          wait
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache     /cache       ext4   noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata  /data        ext4   noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check

/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot      /boot        emmc   defaults                                      recoveryonly
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery  /recovery    emmc   defaults                                      recoveryonly

# MTK IMEI / calibration partitions -- included so you can BACK THEM UP
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram     /nvram       emmc   defaults                                      recoveryonly
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata    /nvdata      ext4   noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1  /protect1    ext4   noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2  /protect2    ext4   noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp       /persistent  emmc   defaults                                      recoveryonly

/dev/block/mmcblk1p1                                            /external_sd vfat   defaults                                      voldmanaged=external_sd:auto
/dev/block/mmcblk1p1                                            /sdcard      vfat   defaults                                      voldmanaged=sdcard:auto
